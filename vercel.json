{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/db run ensure-schema && pnpm --filter @workspace/neurohacking run build",
  "outputDirectory": "artifacts/neurohacking/dist/public",
  "rewrites": [
    {
      "source": "/api/me/:path*",
      "destination": "/api/me?__me_path=/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}